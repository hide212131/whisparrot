<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>spike-s01</AssemblyName>
    <RootNamespace>Spike.S01</RootNamespace>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- S-03 計測用: -p:Backend=cpu|vulkan|cuda|cuda12|all（既定 cpu）。 -->
    <Backend Condition="'$(Backend)' == ''">cpu</Backend>
    <!--
      S-01 の知見: IncludeNativeLibrariesForSelfExtract だけでは Whisper.net が runtimes/<rid>/ を見つけられない
      （AppContext.BaseDirectory が exe のフォルダのまま）。IncludeAllContentForSelfExtract を併用して初めて
      展開先が BaseDirectory になり、CPU 認識が動く。
    -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- 圧縮の効果を測るための切替。-p:Compress=true -->
    <EnableCompressionInSingleFile Condition="'$(Compress)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF と WinForms の型名衝突を避ける -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1"
                      Condition="'$(Backend)' == 'vulkan' or '$(Backend)' == 'all'" />
    <PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="1.9.1"
                      Condition="'$(Backend)' == 'cuda' or '$(Backend)' == 'all'" />
    <PackageReference Include="Whisper.net.Runtime.Cuda12.Windows" Version="1.9.1"
                      Condition="'$(Backend)' == 'cuda12'" />
  </ItemGroup>

  <!--
    S-03 の知見: Whisper.net.Runtime.* の targets は対象 OS / アーキに関係なく全 RID のネイティブを
    出力へ入れる（Vulkan は linux-x64 の .so 58 MB まで入る）。Windows 以外と、対象外アーキを除外する。
    -p:Prune=false で除外を無効化（素の増分を測る用）。
  -->
  <Target Name="PruneNativeRuntimes" BeforeTargets="AssignTargetPaths" Condition="'$(Prune)' != 'false'">
    <ItemGroup>
      <_PruneNone Include="@(None)"
                  Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(FullPath)', '[\\/](linux|android|ios|tvos|maccatalyst|browser|osx|win-x86)[^\\/]*[\\/]'))" />
      <_PruneNone Include="@(None)"
                  Condition="'$(RuntimeIdentifier)' == 'win-x64' and $([System.Text.RegularExpressions.Regex]::IsMatch('%(FullPath)', '[\\/]win-arm64[\\/]'))" />
      <_PruneNone Include="@(None)"
                  Condition="'$(RuntimeIdentifier)' == 'win-arm64' and $([System.Text.RegularExpressions.Regex]::IsMatch('%(FullPath)', '[\\/]win-x64[\\/]'))" />
      <None Remove="@(_PruneNone)" />
    </ItemGroup>
  </Target>

</Project>
